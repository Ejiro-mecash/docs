{
  "info": {
    "name": "meCash Ramp API - Sandbox Chat Samples",
    "description": "Built directly from the sandbox test payloads shared in chat (Olowofela, 20/08/2026). Uses POST {{baseURL}}/v2/ramp/payout for transactions - this differs from the /v1/ramp/order endpoint documented in the mdx docs collection. Saved example responses are attached to each request from the original chat output.\n\nSetup:\n1. Set collection variable api_key\n2. Run the 3 quote requests first - test scripts save each returned quoteId\n3. Run the payout requests - they pull the saved quoteId automatically",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseURL",
      "value": "https://sandboxapi.me-cash.com"
    },
    {
      "key": "api_key",
      "value": ""
    },
    {
      "key": "crypto_quote_id",
      "value": ""
    },
    {
      "key": "offramp_quote_id",
      "value": ""
    },
    {
      "key": "onramp_quote_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Quote - Crypto to Crypto (USDC to USDC)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-api-key",
            "value": "{{api_key}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"paymentChannel\": \"BANK_TRANSFER\",\n    \"source\": {\n        \"amount\": 2,\n        \"symbol\": \"USDC\",\n        \"blockchain\": \"MATIC\"\n    },\n    \"target\": {\n        \"symbol\": \"USDC\",\n        \"blockchain\": \"MATIC\"\n    },\n    \"feeLevel\": {\n        \"type\": \"MEDIUM\"\n    },\n    \"recipient\": {\n        \"address\": \"0xd62acd62fdb155afaa5d12c6caf01119d413dfd9\"\n    }\n}"
        },
        "url": {
          "raw": "{{baseURL}}/v1/ramp/quote",
          "host": [
            "{{baseURL}}"
          ],
          "path": [
            "v1",
            "ramp",
            "quote"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const body = pm.response.json();",
              "if (body && body.data && body.data.id) {",
              "    pm.collectionVariables.set('crypto_quote_id', body.data.id);",
              "}"
            ]
          }
        }
      ],
      "response": [
        {
          "name": "Sample Success 200",
          "originalRequest": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{api_key}}"
              }
            ],
            "url": {
              "raw": "{{baseURL}}/v1/ramp/quote",
              "host": [
                "{{baseURL}}"
              ],
              "path": [
                "v1",
                "ramp",
                "quote"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n    \"paymentChannel\": \"BANK_TRANSFER\",\n    \"source\": {\n        \"amount\": 2,\n        \"symbol\": \"USDC\",\n        \"blockchain\": \"MATIC\"\n    },\n    \"target\": {\n        \"symbol\": \"USDC\",\n        \"blockchain\": \"MATIC\"\n    },\n    \"feeLevel\": {\n        \"type\": \"MEDIUM\"\n    },\n    \"recipient\": {\n        \"address\": \"0xd62acd62fdb155afaa5d12c6caf01119d413dfd9\"\n    }\n}"
            }
